{
  "name": "Little Bits of Buddha",
  "dockerComposeFile": "compose.yaml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/little_bits_of_buddha",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/little_bits_of_buddha,type=bind",
  "postStartCommand": ". /home/gitpod/.nix-profile/etc/profile.d/nix.sh && dapr init --slim || true",
  "updateRemoteUserUID": false,
  "containerUser": "gitpod",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "jetpack-io.devbox",
        "ms-python.python",
        "ms-python.mypy-type-checker",
        "charliermarsh.ruff",
        "njpwerner.autodocstring",
        "ms-python.debugpy"
      ]
    }
  },
  "remoteUser": "gitpod"
}
