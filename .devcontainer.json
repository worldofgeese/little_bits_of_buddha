{
  "name": "Little Bits of Buddha",
  "dockerComposeFile": "compose.yaml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "postCreateCommand": "curl -fsSL https://get.jetpack.io/devbox | bash -s -- -f && curl -fsSL https://raw.githubusercontent.com/dapr/cli/master/install/install.sh | bash && devbox install",
  "postStartCommand": "dapr init --slim || true",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "jetpack-io.devbox",
        "ms-python.python",
        "ms-python.mypy-type-checker",
        "charliermarsh.ruff",
        "njpwerner.autodocstring",
        "ms-python.debugpy"
      ]
    }
  }
}
